# go-hookd Development Environment Configuration
# Copy this file to .env and customize for your local development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5433
DB_USER=hookd_dev
DB_PASSWORD=hookd_dev_password_change_in_production
DB_NAME=hookd_dev
DB_SSLMODE=disable

# Full connection string (alternative to individual values)
DATABASE_URL=postgresql://hookd_dev:hookd_dev_password_change_in_production@localhost:5433/hookd_dev?sslmode=disable

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Worker pool settings
WORKER_COUNT=10
QUEUE_POLL_INTERVAL_MS=1000
DELIVERY_TIMEOUT_MS=30000

# Retry policy defaults
DEFAULT_MAX_RETRIES=10
DEFAULT_INITIAL_BACKOFF_MS=1000
DEFAULT_MAX_BACKOFF_MS=3600000
DEFAULT_BACKOFF_FACTOR=2.0

# Circuit breaker settings
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000
CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# Idempotency TTL
IDEMPOTENCY_TTL_HOURS=24

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=debug
LOG_FORMAT=json

# =============================================================================
# NOTES
# =============================================================================
# - This is a DEVELOPMENT configuration
# - NEVER commit actual credentials to version control
# - For production, use environment-specific configs or secrets management
# - Port 5433 is used to avoid conflicts with other PostgreSQL instances
