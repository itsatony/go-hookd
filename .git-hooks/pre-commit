#!/bin/bash
# go-hookd pre-commit hook
# Enforces vAudience.AI quality standards before commit
# To install: ln -sf ../../.git-hooks/pre-commit .git/hooks/pre-commit

set -e

echo "🔍 Running pre-commit quality gates..."
echo ""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track if any check fails
FAILED=0

# Check 1: go fmt
echo "📝 Checking code formatting (go fmt)..."
UNFORMATTED=$(gofmt -l . 2>&1 | grep -v "^vendor/" || true)
if [ -n "$UNFORMATTED" ]; then
    echo -e "${RED}❌ FAILED: Code is not formatted${NC}"
    echo "   Run: make fmt"
    echo "   Files needing formatting:"
    echo "$UNFORMATTED" | sed 's/^/     /'
    FAILED=1
else
    echo -e "${GREEN}✅ PASSED: Code formatting${NC}"
fi
echo ""

# Check 2: go vet
echo "🔎 Running static analysis (go vet)..."
if go vet ./... 2>&1 | grep -v "^#" ; then
    echo -e "${RED}❌ FAILED: go vet found issues${NC}"
    FAILED=1
else
    echo -e "${GREEN}✅ PASSED: Static analysis${NC}"
fi
echo ""

# Check 3: go test (fast tests only for pre-commit speed)
echo "🧪 Running fast tests (go test -short -race)..."
if go test -short -race ./... > /dev/null 2>&1; then
    echo -e "${GREEN}✅ PASSED: Fast tests${NC}"
else
    echo -e "${RED}❌ FAILED: Tests failed${NC}"
    echo "   Run: make test-short"
    echo "   To see full output: go test -short -race ./..."
    FAILED=1
fi
echo ""

# Final result
if [ $FAILED -eq 1 ]; then
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}❌ PRE-COMMIT CHECKS FAILED${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo "Fix the issues above and try again."
    echo "To bypass this check (not recommended): git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ ALL PRE-COMMIT CHECKS PASSED${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
